<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox" spacing="5" 
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="5" right="5" bottom="5" left="5"/>
    </padding>

    <Label text="Ready Queue:" style="-fx-font-weight: bold"/>
    <ListView fx:id="readyList" VBox.vgrow="ALWAYS"/>

    <Label text="I/O Wait Queue:" style="-fx-font-weight: bold"/>
    <ListView fx:id="ioList" VBox.vgrow="ALWAYS"/>

    <Label text="Sleep/Timer Queue:" style="-fx-font-weight: bold"/>
    <ListView fx:id="sleepList" VBox.vgrow="ALWAYS"/>

</fx:root>
