#
# https://help.github.com/articles/dealing-with-line-endings/
#

# Default LF
* text=auto eol=lf

# Forced LF
*.java text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.fxml text eol=lf
*.css text eol=lf
*.md text eol=lf

# Build files
*.sh text eol=lf
pom.xml text eol=lf
build.gradle text eol=lf
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Ensure these file should not be converted due to malfunction git
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary
*.img binary

